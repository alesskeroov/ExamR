{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DataProtection": {
    "KeysPath": ""
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "AllowedHosts": []
  },
  "Authentication": {
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    }
  },
  "Jwt": {
    "Issuer": "ExamFlow",
    "Audience": "ExamFlow",
    "AccessTokenMinutes": 60
  },
  "Smtp": {
    "Port": 587,
    "EnableSsl": true,
    "From": "no-reply@examflow.local",
    "FromName": "ExamR"
  },
  "Documents": {
    "MaxFileSizeBytes": 20971520,
    "MaxPages": 300,
    "ParseTimeoutSeconds": 60,
    "MaxConcurrentJobs": 2
  },
  "Exam": {
    "MaxQuestions": 200,
    "MinutesPerQuestion": 1,
    "AnswerGraceSeconds": 5
  },
  "Social": {
    "InvitationMinutes": 5
  },
  "StudyAi": {
    "Model": "gpt-4.1-mini",
    "DailyRequestLimit": 50,
    "MaxOutputTokens": 1500,
    "MaxContextCharacters": 10000,
    "MaxChunks": 5,
    "TimeoutSeconds": 45,
    "InputUsdPerMillion": 0.40,
    "CachedInputUsdPerMillion": 0.10,
    "OutputUsdPerMillion": 1.60
  },
  "Storage": {
    "RootPath": "App_Data/uploads"
  }
}
