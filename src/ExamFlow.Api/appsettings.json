{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "ExamFlow",
    "Audience": "ExamFlow",
    "AccessTokenMinutes": 60
  },
  "Smtp": {
    "Port": 587,
    "EnableSsl": true,
    "From": "no-reply@examflow.local",
    "FromName": "ExamFlow"
  },
  "Documents": {
    "MaxFileSizeBytes": 20971520,
    "MaxPages": 300,
    "ParseTimeoutSeconds": 60,
    "MaxConcurrentJobs": 2
  },
  "Exam": {
    "MaxQuestions": 200,
    "MinutesPerQuestion": 1,
    "AnswerGraceSeconds": 5
  },
  "Storage": {
    "RootPath": "App_Data/uploads"
  }
}
