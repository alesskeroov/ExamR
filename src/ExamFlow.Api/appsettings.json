{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Documents": {
    "MaxFileSizeBytes": 20971520,
    "MaxPages": 300,
    "ParseTimeoutSeconds": 60,
    "MaxConcurrentJobs": 2
  },
  "Storage": {
    "RootPath": "App_Data/uploads"
  }
}
