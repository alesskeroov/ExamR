# ExamR production environment — copy the names into Render (backend) and Cloudflare Pages (frontend).
# Never commit real values. "__" separates configuration sections in ASP.NET Core.

# ---------- Render (backend, Docker) ----------
ASPNETCORE_ENVIRONMENT=Production
# Azure SQL: keep Encrypt=True and TrustServerCertificate=False. Connect Timeout covers serverless auto-resume.
ConnectionStrings__Default=Server=tcp:<server>.database.windows.net,1433;Initial Catalog=<db>;User ID=<user>;Password=<password>;Encrypt=True;TrustServerCertificate=False;Connect Timeout=60;
# At least 64 random characters, different from development.
Jwt__SigningKey=<random-64+-chars>

# Public URL users open (the Cloudflare Pages domain). OAuth redirects and cookies use it.
App__PublicOrigin=https://<your-project>.pages.dev
App__FrontendBaseUrl=https://<your-project>.pages.dev
AllowedHosts=*
# Cloudflare → Render → app: trust two proxy hops for the real client IP.
ForwardedHeaders__TrustAllProxies=true
ForwardedHeaders__ForwardLimit=2

# File storage — pick ONE provider (private bucket either way).
# Option A: Supabase Storage (S3 protocol)
# Storage__Provider=S3
# Storage__S3__ServiceUrl=https://<project-ref>.supabase.co/storage/v1/s3
# Storage__S3__Region=<project-region, e.g. eu-central-1>
# Storage__S3__Bucket=examr-files
# Storage__S3__AccessKeyId=<supabase-s3-access-key-id>
# Storage__S3__SecretAccessKey=<supabase-s3-secret-access-key>
# Option B: Cloudflare R2
Storage__Provider=R2
Storage__R2__AccountId=<cloudflare-account-id>
Storage__R2__Bucket=examr-files
Storage__R2__AccessKeyId=<r2-access-key-id>
Storage__R2__SecretAccessKey=<r2-secret-access-key>

# Google OAuth (optional; the button reports "not configured" without it)
Authentication__Google__ClientId=<google-client-id>
Authentication__Google__ClientSecret=<google-client-secret>

# Email: Gmail SMTP (smtp.gmail.com:587, STARTTLS). Password = Google App Password, not the Gmail password.
# Note: Render Free blocks outbound SMTP ports; delivery needs a paid instance or another host.
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__Username=<gmail-address>
Email__Password=<google-app-password>
Email__SenderName=ExamR
# Optional: refuse password login until the address is confirmed (default false)
Email__RequireConfirmedEmail=false

# Limits (defaults shown)
Documents__MaxFileSizeBytes=20971520
Documents__MaxConcurrentJobs=1

# ---------- Cloudflare Pages (frontend) ----------
# Build command: npm run build   Build output: dist   Root directory: client
API_ORIGIN=https://<your-service>.onrender.com
VITE_DEMO_MODE=true
